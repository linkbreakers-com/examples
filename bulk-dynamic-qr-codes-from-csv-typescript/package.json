    "csv-stringify": "^6.9.0",
    "linkbreakers": "^1.190.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
