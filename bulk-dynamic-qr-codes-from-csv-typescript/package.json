{
  "name": "bulk-dynamic-qr-codes-from-csv-typescript",
  "private": true,
  "description": "Bulk-create dynamic QR codes and short links from a CSV with the Linkbreakers TypeScript SDK, then export scan counts",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "create": "tsx bulk-qr.ts create",
    "report": "tsx bulk-qr.ts report",
